   <text>
  
     <body>
        <div type="dramaSketch">
           <head><!-- Given title of the sketch as represented in the publication you're encoding. --></head>
              
              <castList>
                 <head>Characters.</head>
                 <castItem corresp="#Fict-SI-Col">Colantonio del Fiore.</castItem>
                 <!-- ebb: If we're adding these characters to the SI, point to their SI entries with @corresp attributes and a leading #. 
                 Othwerise, you can set an xml:id on these, and then refer with @who or @ref throughout the sketch body to the castlist entries where mentioned or where speaking. 
                 I'm pretending we already have these in an SI file, but we don't have them yet These are just "dummy" attribute values. 
                 -->
                 <castItem corresp="#Fict-SI-Ang">Angelo Solario.</castItem>
                 <castItem corresp="#Fict-SI-Lau">Laura.</castItem>
                 <castItem corresp="#Fict-SI-Lis">Lisabetta.</castItem>
              </castList>
              
        <div type="scene" n="1">
           <!-- IF your sketch has only one scene, just remove the n="1" on the div. -->
           <stage type="setting">SCENE – An Artist’s Painting Room – Flower-pieces finished and unfinished on the walls and the easel 
              – a large picture covered with a veil in the front.</stage>
           
           <sp who="#Fict-SI-Col"><!--  @who points to a defined id in the castList / SI.-->
              <speaker>Col.</speaker> <!-- <speaker element contains the representation of speaker's name/role in the source text at this point. -->
              <l>GOOD LISABETTA, know’st thou of my daughter,</l>
               <l>Madonna Laura? I have sought in vain Her chamber</l>
               <l>and her garden bower.</l>
           </sp>
           <sp who="#Fict-SI-Lis">
              <speaker>Lis.</speaker>
              <l rend="indent(+5)">She's still</l>
              <l>At vespers, signor.</l>
           </sp>
           <sp who="#Fict-SI-Col">
              <speaker>Col.</speaker>
              <l rend="indent(+3)">Aye, I might have <app><rdg wit="#A1">guess’d—</rdg><rdg wit="#B2">guessed,</rdg></app></l>
              <!-- In the line above, I pretend that I saw a variation between texts A1 and B2 over how they represent the word "guessed" 
              and its following punctuation: that's how to code an <app> for critical apparatus markup. 
              -->
              <l>My fair and pensive nun! She flies the light</l>
              <l>.....</l>
              <l>.....</l>
           </sp>
           <!-- CONTINUE CODING SPEECHES / STAGE DIRECTIONS -->
        
  
        </div><!-- END DIV TAG FOR THIS SCENE -->
        
        
        </div><!-- END DIV TAG FOR WHOLE SKETCH -->
     </body>
   </text>
